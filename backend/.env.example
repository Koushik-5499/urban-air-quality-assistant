# Application Settings
APP_NAME="Urban Air Quality Assistant API"
APP_VERSION="1.0.0"
APP_ENV="development"
API_V1_PREFIX="/api/v1"

# CORS Configuration
# Accepts JSON array (e.g. ["http://localhost:5173"]) or comma-separated string
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database URL
DATABASE_URL="sqlite:///./air_quality.db"

# Gemini AI Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_PROVIDER="gemini"
AI_ENABLED=true
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# External AQI Provider Configuration (CPCB / data.gov.in)
# Base endpoint for CPCB Real-time Air Quality Index dataset (Resource ID: 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69)
CPCB_API_BASE_URL="https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69"

# API Key obtained by registering at https://data.gov.in/ (Dashboard -> My Account)
# Optional in development (application can use AQI_PROVIDER="mock" or run safely without key)
CPCB_API_KEY=""

# Active Provider: "cpcb" or "mock"
AQI_PROVIDER="cpcb"

# Provider HTTP request timeout in seconds
AQI_FETCH_TIMEOUT=10.0

# In-memory cache TTL for observations in seconds (default: 300 = 5 minutes)
AQI_CACHE_TTL_SECONDS=300

# Transient error maximum retry count
AQI_MAX_RETRIES=2

# Optional admin secret required for POST /api/v1/air-quality/sync (leave empty for open local dev)
SYNC_ADMIN_SECRET=""

# Alerts and Notifications Configuration
ALERTS_ENABLED=true
ALERT_POLL_INTERVAL_SECONDS=300
ALERT_DETERIORATION_THRESHOLD=30
ALERT_IMPROVEMENT_THRESHOLD=40
ALERT_EXPIRATION_HOURS=24
ALERT_ADMIN_SECRET=""

# Email Notifications (Resend)
RESEND_API_KEY=""
ALERT_EMAIL_FROM="alerts@urbanairquality.org"
EMAIL_NOTIFICATIONS_ENABLED=false

# Web Push Notifications (VAPID)
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@urbanairquality.org"

# Weather Integration Configuration
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1"
WEATHER_REQUEST_TIMEOUT=10.0
WEATHER_ENABLED=true
WEATHER_CACHE_TTL_SECONDS=900

# Forecasting Engine Configuration
FORECAST_MODEL="exponential_smoothing"
FORECAST_MIN_TRAINING_SAMPLES=24
FORECAST_ADMIN_SECRET=""
FORECAST_DEFAULT_HORIZON_HOURS=24

