# Urban Air Quality Assistant — Environment Configuration
# Copy this file to .env.local to customize for local or staging environments

# Backend API Base URL (leave unset or empty to use client-side demonstration data)
VITE_API_BASE_URL=https://api.urbanairquality.example.com/v1

# Default Request Timeout in Milliseconds
VITE_API_TIMEOUT_MS=10000

# Application Environment Mode ('development' | 'staging' | 'production')
VITE_APP_ENV=development
